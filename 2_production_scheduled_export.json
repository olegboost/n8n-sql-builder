{
  "name": "Production - Scheduled export (reviewed SQL)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * MON"
            }
          ]
        }
      },
      "id": "b1b2c3d4-0001-4000-8000-000000000001",
      "name": "Schedule Trigger (every Monday 08:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "REPLACE_WITH_SQL_VALIDATED_IN_STEP_1\n-- Example:\n-- SELECT customer_id, order_date, amount\n-- FROM orders\n-- WHERE order_date >= $1 AND order_date < $2\n-- ORDER BY order_date\n-- LIMIT 5000;",
        "options": {
          "queryReplacement": "={{ [$today.minus({days:7}).toISODate(), $today.toISODate()] }}"
        }
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000002",
      "name": "Postgres (Execute Query - reviewed SQL)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-160, 0],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_PRODUCTION_READONLY_CREDENTIAL_ID",
          "name": "Postgres - production readonly"
        }
      }
    },
    {
      "parameters": {
        "operation": "toCsv",
        "options": {
          "fileName": "weekly_export.csv"
        }
      },
      "id": "b1b2c3d4-0003-4000-8000-000000000003",
      "name": "Convert to CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [80, 0]
    },
    {
      "parameters": {
        "sendTo": "REPLACE_WITH_RECIPIENT_OR_DISTRIBUTION_LIST",
        "subject": "Weekly export - {{ $today.toISODate() }}",
        "message": "Автоматическая еженедельная выгрузка. Файл во вложении.",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {}
            ]
          }
        }
      },
      "id": "b1b2c3d4-0004-4000-8000-000000000004",
      "name": "Send email with attachment",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [320, 0],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_SMTP_CREDENTIAL_ID",
          "name": "Internal SMTP"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "b1b2c3d4-0005-4000-8000-000000000005",
      "name": "If error occurred",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-160, 220]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": "REPLACE_WITH_SLACK_CHANNEL_ID",
        "text": "⚠️ Ошибка в scheduled export workflow: {{ $json.error }}"
      },
      "id": "b1b2c3d4-0006-4000-8000-000000000006",
      "name": "Notify on error (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [80, 220],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_SLACK_CREDENTIAL_ID",
          "name": "Slack - internal bot"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger (every Monday 08:00)": {
      "main": [[{ "node": "Postgres (Execute Query - reviewed SQL)", "type": "main", "index": 0 }]]
    },
    "Postgres (Execute Query - reviewed SQL)": {
      "main": [[{ "node": "Convert to CSV", "type": "main", "index": 0 }]],
      "error": [[{ "node": "If error occurred", "type": "main", "index": 0 }]]
    },
    "Convert to CSV": {
      "main": [[{ "node": "Send email with attachment", "type": "main", "index": 0 }]]
    },
    "If error occurred": {
      "main": [[{ "node": "Notify on error (Slack)", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": ""
  },
  "pinData": {}
}
