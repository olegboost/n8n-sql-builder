{
  "name": "AI SQL Assistant (read-only exploration)",
  "nodes": [
    {
      "parameters": {
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [-400, 0],
      "webhookId": "ai-sql-assistant-chat"
    },
    {
      "parameters": {
        "model": {
          "value": "REPLACE_WITH_SELF_HOSTED_MODEL_NAME"
        },
        "options": {
          "baseURL": "https://internal-llm-gateway.bank.local/v1"
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Internal LLM (OpenAI-compatible)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [-400, 220],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_VAULT_MANAGED_CREDENTIAL_ID",
          "name": "Internal LLM Gateway (Vault)"
        }
      }
    },
    {
      "parameters": {
        "contextWindowLength": 10
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [-160, 220]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $fromAI('sql_query', 'A single valid read-only PostgreSQL SELECT statement. Never include INSERT, UPDATE, DELETE, DROP, TRUNCATE or ALTER. Always include a LIMIT clause capped at 500 rows.') }}",
        "options": {
          "queryReplacement": "={{ [] }}"
        }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Postgres (read-only tool)",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [80, 220],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_READONLY_SANDBOX_CREDENTIAL_ID",
          "name": "Postgres - readonly sandbox/replica"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT table_schema, table_name, column_name, data_type FROM information_schema.columns WHERE table_schema NOT IN ('pg_catalog','information_schema') ORDER BY table_schema, table_name, ordinal_position;",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Get schema (tool)",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [320, 220],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_READONLY_SANDBOX_CREDENTIAL_ID",
          "name": "Postgres - readonly sandbox/replica"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "Ты — ассистент аналитика для PostgreSQL. У тебя два инструмента: 'Get schema (tool)' — чтобы узнать структуру таблиц, и 'Postgres (read-only tool)' — чтобы выполнить ЧИСТО SELECT-запрос и посмотреть результат. Правила: 1) Сначала всегда проверяй схему через Get schema, если не уверен в именах таблиц/колонок. 2) Никогда не генерируй INSERT/UPDATE/DELETE/DROP/ALTER/TRUNCATE. 3) Всегда добавляй LIMIT (максимум 500 строк) в SELECT. 4) В финальном ответе пользователю обязательно выведи итоговый SQL-запрос отдельным блоком кода, чтобы его можно было скопировать. 5) Если запрос пользователя неоднозначен — задай уточняющий вопрос вместо угадывания."
        }
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [-160, 0]
    }
  ],
  "connections": {
    "When chat message received": {
      "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]]
    },
    "Internal LLM (OpenAI-compatible)": {
      "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "Chat Memory": {
      "ai_memory": [[{ "node": "AI Agent", "type": "ai_memory", "index": 0 }]]
    },
    "Postgres (read-only tool)": {
      "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]]
    },
    "Get schema (tool)": {
      "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
